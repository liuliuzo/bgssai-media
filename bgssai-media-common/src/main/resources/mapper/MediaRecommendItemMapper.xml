<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.media.common.mapper.MediaRecommendItemMapper">
  <resultMap id="BaseResultMap" type="com.bgssai.media.common.domain.MediaRecommendItem">
    <id column="id" property="id"/>
    <result column="run_id" property="runId"/>
    <result column="video_id" property="videoId"/>
    <result column="stage" property="stage"/>
    <result column="recall_reason" property="recallReason"/>
    <result column="filter_reason" property="filterReason"/>
    <result column="sort_rank" property="sortRank"/>
    <result column="kept" property="kept"/>
    <result column="created_at" property="createdAt"/>
  </resultMap>

  <sql id="Base_Column_List">id, run_id, video_id, stage, recall_reason, filter_reason, sort_rank, kept, created_at</sql>

  <sql id="Example_Where_Clause">
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <if test="criteria.valid">
          <trim prefix="(" prefixOverrides="and" suffix=")">
            <foreach collection="criteria.criteria" item="criterion">
              <choose>
                <when test="criterion.noValue">and ${criterion.condition}</when>
                <when test="criterion.singleValue">and ${criterion.condition} #{criterion.value}</when>
                <when test="criterion.listValue">
                  and ${criterion.condition}
                  <foreach collection="criterion.value" item="listItem" open="(" close=")" separator=",">
                    #{listItem}
                  </foreach>
                </when>
              </choose>
            </foreach>
          </trim>
        </if>
      </foreach>
    </where>
  </sql>

  <select id="selectByExample" resultMap="BaseResultMap">
    select <include refid="Base_Column_List"/>
    from media_recommend_item
    <if test="_parameter != null"><include refid="Example_Where_Clause"/></if>
    <if test="orderByClause != null">order by ${orderByClause}</if>
  </select>

  <select id="countByExample" resultType="long">
    select count(*) from media_recommend_item
    <if test="_parameter != null"><include refid="Example_Where_Clause"/></if>
  </select>

  <insert id="insertSelective" parameterType="com.bgssai.media.common.domain.MediaRecommendItem"
          useGeneratedKeys="true" keyProperty="id">
    insert into media_recommend_item
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="runId != null">run_id,</if>
      <if test="videoId != null">video_id,</if>
      <if test="stage != null">stage,</if>
      <if test="recallReason != null">recall_reason,</if>
      <if test="filterReason != null">filter_reason,</if>
      <if test="sortRank != null">sort_rank,</if>
      <if test="kept != null">kept,</if>
      <if test="createdAt != null">created_at,</if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      <if test="runId != null">#{runId},</if>
      <if test="videoId != null">#{videoId},</if>
      <if test="stage != null">#{stage},</if>
      <if test="recallReason != null">#{recallReason},</if>
      <if test="filterReason != null">#{filterReason},</if>
      <if test="sortRank != null">#{sortRank},</if>
      <if test="kept != null">#{kept},</if>
      <if test="createdAt != null">#{createdAt},</if>
    </trim>
  </insert>

</mapper>
