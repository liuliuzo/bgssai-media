<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.bgssai.media.common.mapper.MediaIngestLogMapper">
  <resultMap id="BaseResultMap" type="com.bgssai.media.common.domain.MediaIngestLog">
    <id column="id" property="id"/>
    <result column="external_ref" property="externalRef"/>
    <result column="drama_id" property="dramaId"/>
    <result column="payload_json" property="payloadJson"/>
    <result column="status" property="status"/>
    <result column="message" property="message"/>
    <result column="idempotency_key" property="idempotencyKey"/>
    <result column="media_id" property="mediaId"/>
    <result column="play_url" property="playUrl"/>
    <result column="created_at" property="createdAt"/>
  </resultMap>

  <sql id="Base_Column_List">
    id, external_ref, drama_id, payload_json, status, message, idempotency_key, media_id, play_url, created_at
  </sql>

  <sql id="Example_Where_Clause">
    <where>
      <foreach collection="oredCriteria" item="criteria" separator="or">
        <if test="criteria.valid">
          <trim prefix="(" prefixOverrides="and" suffix=")">
            <foreach collection="criteria.criteria" item="criterion">
              <choose>
                <when test="criterion.noValue">and ${criterion.condition}</when>
                <when test="criterion.singleValue">and ${criterion.condition} #{criterion.value}</when>
              </choose>
            </foreach>
          </trim>
        </if>
      </foreach>
    </where>
  </sql>

  <select id="selectByExample" resultMap="BaseResultMap">
    select <include refid="Base_Column_List"/> from media_ingest_log
    <if test="_parameter != null"><include refid="Example_Where_Clause"/></if>
    <if test="orderByClause != null">order by ${orderByClause}</if>
  </select>
  <select id="selectByPrimaryKey" resultMap="BaseResultMap" parameterType="long">
    select <include refid="Base_Column_List"/> from media_ingest_log where id = #{id}
  </select>
  <select id="selectByIdempotencyKey" resultMap="BaseResultMap">
    select <include refid="Base_Column_List"/> from media_ingest_log where idempotency_key = #{idempotencyKey} limit 1
  </select>
  <select id="selectByMediaId" resultMap="BaseResultMap">
    select <include refid="Base_Column_List"/> from media_ingest_log where media_id = #{mediaId} order by id desc limit 1
  </select>
  <insert id="insertSelective" parameterType="com.bgssai.media.common.domain.MediaIngestLog" useGeneratedKeys="true" keyProperty="id">
    insert into media_ingest_log
    <trim prefix="(" suffix=")" suffixOverrides=",">
      <if test="externalRef != null">external_ref,</if>
      <if test="dramaId != null">drama_id,</if>
      <if test="payloadJson != null">payload_json,</if>
      <if test="status != null">status,</if>
      <if test="message != null">message,</if>
      <if test="idempotencyKey != null">idempotency_key,</if>
      <if test="mediaId != null">media_id,</if>
      <if test="playUrl != null">play_url,</if>
    </trim>
    <trim prefix="values (" suffix=")" suffixOverrides=",">
      <if test="externalRef != null">#{externalRef},</if>
      <if test="dramaId != null">#{dramaId},</if>
      <if test="payloadJson != null">#{payloadJson},</if>
      <if test="status != null">#{status},</if>
      <if test="message != null">#{message},</if>
      <if test="idempotencyKey != null">#{idempotencyKey},</if>
      <if test="mediaId != null">#{mediaId},</if>
      <if test="playUrl != null">#{playUrl},</if>
    </trim>
  </insert>
  <update id="updateByIdempotencyKey" parameterType="com.bgssai.media.common.domain.MediaIngestLog">
    update media_ingest_log
    <set>
      <if test="externalRef != null">external_ref = #{externalRef},</if>
      drama_id = #{dramaId},
      <if test="payloadJson != null">payload_json = #{payloadJson},</if>
      <if test="status != null">status = #{status},</if>
      <if test="message != null">message = #{message},</if>
      media_id = #{mediaId},
      play_url = #{playUrl},
    </set>
    where idempotency_key = #{idempotencyKey}
  </update>

  <select id="listRecentContract" resultMap="BaseResultMap">
    select l.id, l.external_ref, l.drama_id, l.payload_json, l.status, l.message,
           l.idempotency_key, l.media_id, l.play_url, l.created_at
    from media_ingest_log l
    inner join (
      select media_id, max(id) as id
      from media_ingest_log
      where media_id is not null and media_id != ''
        and status = 'READY'
      group by media_id
    ) latest on latest.id = l.id
    order by l.id desc
    limit #{limit} offset #{offset}
  </select>
  <select id="countContract" resultType="long">
    select count(distinct media_id) from media_ingest_log
    where media_id is not null and media_id != ''
      and status = 'READY'
  </select>
</mapper>
