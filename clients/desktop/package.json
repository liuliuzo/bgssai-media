{
  "name": "bgssai-media-clients-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "BGSSAI Media single desktop app (Win/macOS/Linux) with dual login entrances",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "pack": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win",
    "dist:mac": "electron-builder --mac",
    "dist:linux": "electron-builder --linux AppImage"
  },
  "build": {
    "appId": "com.bgssai.media.desktop",
    "productName": "BGSSAI Media",
    "directories": {
      "output": "release"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "package.json"
    ],
    "win": {
      "target": ["nsis"],
      "fileAssociations": [
        { "ext": "mp4", "name": "MP4 Video", "description": "BGSSAI Media Video File", "role": "Viewer" },
        { "ext": "mkv", "name": "MKV Video", "description": "BGSSAI Media Video File", "role": "Viewer" },
        { "ext": "webm", "name": "WebM Video", "description": "BGSSAI Media Video File", "role": "Viewer" },
        { "ext": "mov", "name": "QuickTime Video", "description": "BGSSAI Media Video File", "role": "Viewer" },
        { "ext": "avi", "name": "AVI Video", "description": "BGSSAI Media Video File", "role": "Viewer" },
        { "ext": "flv", "name": "Flash Video", "description": "BGSSAI Media Video File", "role": "Viewer" },
        { "ext": "wmv", "name": "Windows Media Video", "description": "BGSSAI Media Video File", "role": "Viewer" },
        { "ext": "ts", "name": "MPEG Transport Stream", "description": "BGSSAI Media Video File", "role": "Viewer" },
        { "ext": "mp3", "name": "MP3 Audio", "description": "BGSSAI Media Audio File", "role": "Viewer" },
        { "ext": "flac", "name": "FLAC Audio", "description": "BGSSAI Media Audio File", "role": "Viewer" },
        { "ext": "wav", "name": "WAV Audio", "description": "BGSSAI Media Audio File", "role": "Viewer" }
      ]
    },
    "mac": {
      "target": ["dmg"],
      "category": "public.app-category.entertainment"
    },
    "linux": {
      "target": ["AppImage"],
      "category": "AudioVideo"
    }
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  }
}
