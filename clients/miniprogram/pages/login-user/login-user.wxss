.page {
  padding: 64rpx 48rpx;
}

.title {
  font-size: 44rpx;
  font-weight: 700;
}

.sub {
  margin: 16rpx 0 48rpx;
  color: #9aabbf;
  font-size: 26rpx;
}

.field {
  margin-bottom: 24rpx;
  padding: 20rpx 24rpx;
  background: rgba(255, 255, 255, 0.06);
  border-radius: 12rpx;
  color: #f4f7fb;
}

.btn {
  margin: 16rpx 0 0;
  border-radius: 12rpx;
  font-weight: 600;
  color: #f4f7fb;
}

.btn.primary {
  background: #2f6fed;
}

.btn.ghost {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #9aabbf;
}

.btn::after {
  border: none;
}

.err {
  margin-top: 24rpx;
  color: #f07178;
  font-size: 24rpx;
}
