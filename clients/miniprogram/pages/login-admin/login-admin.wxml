<view class="page">
  <view class="title">管理登录</view>
  <view class="sub">角色 PLATFORM_ADMIN · 同一小程序的管理入口</view>
  <input class="field" placeholder="管理员账号" value="{{username}}" bindinput="onUser" />
  <input class="field" password placeholder="密码" value="{{password}}" bindinput="onPass" />
  <button class="btn primary" loading="{{loading}}" bindtap="onSubmit">登录</button>
  <button class="btn ghost" bindtap="openH5">改用 H5（web-view）</button>
  <view class="err" wx:if="{{error}}">{{error}}</view>
</view>
