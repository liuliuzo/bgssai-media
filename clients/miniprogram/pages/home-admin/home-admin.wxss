.page {
  padding: 64rpx 48rpx;
}

.title {
  font-size: 40rpx;
  font-weight: 700;
}

.sub {
  margin: 16rpx 0 48rpx;
  color: #9aabbf;
  line-height: 1.5;
}

.btn {
  margin-bottom: 20rpx;
  background: #c45c26;
  color: #f4f7fb;
  border-radius: 12rpx;
  font-weight: 600;
}

.btn.ghost {
  background: transparent;
  border: 1px solid rgba(255, 255, 255, 0.2);
  color: #9aabbf;
}

.btn::after {
  border: none;
}
