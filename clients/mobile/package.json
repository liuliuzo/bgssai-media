{
  "name": "bgssai-media-clients-mobile",
  "version": "0.1.0",
  "private": true,
  "description": "BGSSAI Media single mobile app (iOS+Android) with dual login entrances",
  "scripts": {
    "build:www": "node scripts/copy-www.js",
    "sync": "npm run build:www && npx cap sync",
    "open:android": "npx cap open android",
