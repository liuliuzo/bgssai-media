{
  "name": "bgssai-media-desktop",
  "version": "0.1.1",
  "private": true,
  "description": "BGSSAI media desktop player (Electron + system libVLC/VLC)",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "test": "node --test",
    "smoke:vlc": "node scripts/smoke-vlc.js",
    "smoke:builtin": "electron scripts/smoke-builtin.js",
    "build": "electron-builder --dir",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win nsis portable",
    "dist:mac": "electron-builder --mac dmg",
    "dist:linux": "electron-builder --linux AppImage deb",
    "checksums": "node scripts/checksums.js"
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "com.bgssai.media.desktop",
    "productName": "BGSSAI Media Player",
    "beforePack": "scripts/verify-engines.js",
    "artifactName": "bgssai-media-player-${version}-${os}-${arch}.${ext}",
    "directories": {
      "output": "dist"
    },
    "asarUnpack": ["node_modules/ffmpeg-static/**", "node_modules/ffprobe-static/**"],
    "files": [
      "electron/**",
      "renderer/**",
      "shared/**",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "vendor/vlc",
        "to": "vlc",
        "filter": [
          "**/*"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "portable"
      ],
      "artifactName": "bgssai-media-player-${version}-win-${arch}.${ext}"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "category": "public.app-category.video"
    },
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "AudioVideo"
    },
    "publish": null
  },
  "dependencies": {
    "ffmpeg-static": "5.3.0",
    "ffprobe-static": "3.1.0"
  }
}
