{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://bgssai.com/contracts/short-drama-publish.schema.json",
  "title": "bgssai-short to bgssai-media publish payload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "source_system",
    "source_work_id",
    "source_episode_id",
    "source_film_id",
    "title",
    "idempotency_key"
  ],
  "properties": {
    "source_system": { "const": "bgssai-short" },
    "source_work_id": { "type": "string", "minLength": 1 },
    "source_episode_id": { "type": "string", "minLength": 1 },
    "source_film_id": { "type": "string", "minLength": 1 },
    "title": { "type": "string", "minLength": 1 },
    "cover_url": { "type": ["string", "null"] },
    "video_url": { "type": "string" },
    "duration_sec": { "type": "integer", "minimum": 0 },
    "aspect_ratio": { "type": "string", "default": "9:16" },
    "language": { "type": "string", "default": "zh-CN" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "status": {
      "type": "string",
      "description": "Optional pack status from short. READY or APPROVED accepted. Omitted = approved READY pack."
    },
    "approved": {
      "type": ["boolean", "null"],
      "description": "Optional approval flag from short. false is rejected. null/true accepted."
    },
    "idempotency_key": {
      "type": "string",
      "pattern": "^short:[^:]+:[^:]+:[^:]+$"
    }
  }
}
